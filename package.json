{
  "name": "yarn-playground",
  "version": "0.2.0",
  "description": "Yarn Playground - Interactive Yarn Spinner script editor and visualizer",
  "main": "index.js",
  "scripts": {
    "dev": "lsof -ti:5173 | xargs kill -9 || true && cd csharp/YarnSpinnerJS && dotnet build -c Release && cd ../.. && rm -rf public/_framework && cp -r csharp/YarnSpinnerJS/bin/Release/net10.0/wwwroot/_framework public/ && pnpm vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/test-runner.ts"
  },
  "keywords": [
    "yarn-spinner",
    "parser",
    "typescript",
    "webassembly",
    "blazor",
    "playground"
  ],
  "author": "Wickes1",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/wickes1/yarn-playground.git"
  },
  "bugs": {
    "url": "https://github.com/wickes1/yarn-playground/issues"
  },
  "homepage": "https://yarn.wickend.dev",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "^0.556.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.7.0",
    "vis-network": "^10.1.2"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "^3.4.17"
    }
  }
}
